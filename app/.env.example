# Everything here is optional. Rundown runs with none of it, and nothing below is switched on by default.
# Copy this file to app/.env for development. The plugin does not read it.
# Generated from app/server/src/core/config.ts by app/scripts/env-example.mjs: change the list there.

# The port the server listens on (127.0.0.1 only). Optional; the default is 4000. PORT works too.
# RUNDOWN_PORT=4000

# The project to show is chosen in the app. To start on a given folder instead, set RUNDOWN_ROOT (optional).
# RUNDOWN_ROOT=/path/to/your/project

# Ask: questions about a step or a file go to Claude. Optional; without a key, Ask is off and the rest works.
# ANTHROPIC_API_KEY=

# The model Ask uses (optional; the default is claude-opus-5).
# CLAUDE_MODEL=claude-opus-5

# Only if your key is not scoped to a workspace (optional).
# ANTHROPIC_WORKSPACE_ID=

# At most this many files on the map (optional; the default is 3000).
# RUNDOWN_MAX_FILES=3000

# How the map watches the disk: folders or recursive (optional; the platform's cheap mode by default).
# RUNDOWN_MAP_WATCH=folders

# 0 turns the check for a newer version off (optional).
# RUNDOWN_UPDATE_CHECK=0

# off turns the anonymous usage counts off, whatever the setting in the app (optional). DO_NOT_TRACK=1 does too.
# RUNDOWN_USAGE=off

# 1 lets a dev build send the usage counts (for testing the report; optional).
# RUNDOWN_USAGE_DEV=1

# Where the usage counts go (for testing the report; optional).
# RUNDOWN_USAGE_URL=http://127.0.0.1:3000/api/usage
