{
  "name": "brainstorm-server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . && (tsc -p . -w --preserveWatchOutput &) && node --watch --watch-preserve-output dist/main.js",
    "start": "node dist/main.js",
    "test:bus": "tsc -p . && node --test dist/core/bus.service.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-ws": "^11.2.6",
    "@nestjs/websockets": "^11.2.6",
    "chokidar": "^4.0.3",
    "openai": "^7.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  }
}
